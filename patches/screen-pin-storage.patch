+bool DataStore::saveScreenPinPrefs(NodePrefs& prefs) {
+  // Only the owned temporary/backup files participate. Existing prefs are not
+  // truncated before a complete write, close and read-back verification.
+  const char* temp="/screen_pin.tmp";
+  const char* backup="/screen_pin.bak";
+  const char* primary="/prefs.json";
+  File output=openWrite(_fs,temp);
+  if(!output)return false;
+  ScreenPinWriteStream checked(output);
+  const bool serialized=prefs.saveSerial(checked);
+  checked.flush();output.close();
+  uint8_t expected[32];checked.hash.finish(expected);
+  bool verified=serialized && checked.good;
+  File input=openRead(_fs,temp);
+  if(!input)verified=false;
+  if(input){
+    meshis::pin_detail::Sha256 hash;size_t count=0;
+    while(input.available()){
+      const int value=input.read();if(value<0){verified=false;break;}
+      const uint8_t byte=uint8_t(value);hash.update(&byte,1);++count;
+    }
+    uint8_t actual[32];hash.finish(actual);input.close();
+    verified=verified && count==checked.count && meshis::pin_detail::equal(actual,expected,32);
+    meshis::pin_detail::wipe(actual,sizeof(actual));
+  }
+  meshis::pin_detail::wipe(expected,sizeof(expected));
+  if(verified){
+    File parsed=openRead(_fs,temp);
+    NodePrefs roundtrip;
+    verified=parsed && roundtrip.loadSerial(parsed);
+    if(parsed)parsed.close();
+    verified=verified && memcmp(&roundtrip.meshis_screen_pin,&prefs.meshis_screen_pin,sizeof(meshis::PinRecord))==0;
+    meshis::pin_detail::wipe(&roundtrip.meshis_screen_pin,sizeof(meshis::PinRecord));
+  }
+  if(!verified){_fs->remove(temp);return false;}
+  // LittleFS supports atomic replacement. SPIFFS can reject an existing target;
+  // its fallback keeps an owned old copy which loadPrefs also understands.
+  if(_fs->rename(temp,primary)){_fs->remove(backup);return true;}
+  if(!_fs->exists(primary)){_fs->remove(temp);return false;}
+  if(_fs->exists(backup) && !_fs->remove(backup)){_fs->remove(temp);return false;}
+  if(!_fs->rename(primary,backup)){_fs->remove(temp);return false;}
+  if(!_fs->rename(temp,primary)){
+    _fs->rename(backup,primary); // If restoration fails, startup reads backup.
+    _fs->remove(temp);return false;
+  }
+  _fs->remove(backup);return true;
+}
