+#if defined(MESHIS_V2)
+namespace {
+class ScreenPinWriteStream : public Stream {
+  File& file_;
+public:
+  meshis::pin_detail::Sha256 hash;
+  size_t count=0;
+  bool good=true;
+  explicit ScreenPinWriteStream(File& file):file_(file){}
+  size_t write(uint8_t value) override { return write(&value,1); }
+  size_t write(const uint8_t* data,size_t length) override {
+    const size_t actual=file_.write(data,length);good=good && actual==length;
+    hash.update(data,length);count+=length;return actual;
+  }
+  int available() override {return 0;}
+  int read() override {return -1;}
+  int peek() override {return -1;}
+  void flush() override {file_.flush();}
+};
+}
