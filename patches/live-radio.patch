+// Conservative scan-only guard observes normal TX and uncertain failures as well.
+// It does not replace MeshCore's scheduler or certify regulatory compliance.
+static uint32_t meshisLastObservedTx=0;
+bool MyMesh::meshisTrackDiscovery(mesh::Packet* packet){
+  // Native sendZeroHop returns void. Confirm admission before reporting queued.
+  for(int n=0;n<_mgr->getOutboundTotal();++n)if(_mgr->getOutboundByIdx(n)==packet){_meshisDiscoveryQueue.track(packet);return true;}
+  return false;
+}
+void MyMesh::meshisCancelDiscovery(bool force){
+  if(force || !meshis::activeDiscovery().receiveAllowed(_meshisDiscoveryQueue.requestTag(),millis()))_meshisDiscoveryQueue.cancel(*_mgr);
+}
+
+void MyMesh::logTx(mesh::Packet* packet,int len){
+  _meshisDiscoveryQueue.finished(packet);
+  const uint32_t total=getTotalAirTime(),actual=total-meshisLastObservedTx;meshisLastObservedTx=total;
+  const uint32_t estimate=radio_driver.getEstAirtimeFor(packet->getRawLength());
+  const uint32_t bound=estimate+estimate/2+10;
+  meshis::activeDiscovery().accountAirtime(millis(),actual>bound?actual:bound);
+  BaseChatMesh::logTx(packet,len);
+}
+void MyMesh::logTxFail(mesh::Packet* packet,int len){
+  _meshisDiscoveryQueue.finished(packet);
+  const uint32_t estimate=radio_driver.getEstAirtimeFor(packet->getRawLength());
+  meshis::activeDiscovery().accountAirtime(millis(),estimate+estimate/2+10);
+  BaseChatMesh::logTxFail(packet,len);
+}
+void MyMesh::logRx(mesh::Packet* packet,int len,float score){
+  static_assert(MAX_HASH_SIZE<=16,"Telemetry packet hash capacity");
+  uint8_t hash[MAX_HASH_SIZE];packet->calculatePacketHash(hash);
+  meshis::runtimeTelemetry().notePacket(packet,hash,MAX_HASH_SIZE,radio_driver.getLastRSSI(),millis());
+  BaseChatMesh::logRx(packet,len,score);
+}
+void MyMesh::onAdvertRecv(mesh::Packet* packet,const mesh::Identity& id,uint32_t timestamp,const uint8_t* app_data,size_t app_data_len){
+  uint8_t hash[MAX_HASH_SIZE];packet->calculatePacketHash(hash);
+  const bool direct=packet->getRouteType()!=ROUTE_TYPE_TRANSPORT_DIRECT && mesh::Packet::isValidPathLen(packet->path_len) && packet->getPathHashCount()==0;
+  auto& telemetry=meshis::runtimeTelemetry();telemetry.beginAdvert(packet,hash,MAX_HASH_SIZE,direct,millis());
+  // Mesh has already validated the signature; BaseChatMesh retains parsing/replay checks.
+  BaseChatMesh::onAdvertRecv(packet,id,timestamp,app_data,app_data_len);
+  telemetry.endAdvert();
+}
